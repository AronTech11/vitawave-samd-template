{
  "name": "vitawave-samd-template",
  "version": "1.0.0",
  "description": "VitaWave SAMD Template - Mobile app with BLE support and backend",
  "private": true,
  "workspaces": [
    "mobile",
    "backend"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=mobile",
    "backend": "npm run dev --workspace=backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:ci": "npm run test:ci --workspaces",
    "type-check": "npm run type-check --workspaces",
    "build": "npm run build --workspaces",
    "clean": "rm -rf node_modules mobile/node_modules backend/node_modules"
  },
  "keywords": [
    "react-native",
    "expo",
    "ble",
    "bluetooth",
    "vitawave",
    "samd"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-native": "^4.1.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0"
  }
}
